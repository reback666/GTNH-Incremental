{
  "name": "gtnh-incremental",
  "private": true,
  "version": "0.9.3",
  "type": "module",
  "description": "GTNH-Incremental 本地增量游戏：数值模拟、工业控制台与实时厂区",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "tsx scripts/balance.ts",
    "dev": "vite",
    "dev:demo": "vite --open /demo.html",
    "build:demo": "vue-tsc --noEmit && tsx scripts/build-game.ts --demo",
    "build": "npm run check:content && vue-tsc --noEmit && tsx scripts/build-game.ts",
    "preview": "vite preview",
    "floor:data": "node scripts/build-floor-data.mjs",
    "check:content": "tsx scripts/check-content.ts"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "nbtify": "2.2.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "puppeteer-core": "24.31.0",
    "three": "^0.170.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8",
    "vue-tsc": "^3.3.11"
  }
}
