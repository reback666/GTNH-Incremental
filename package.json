{
  "name": "gtnh-incremental",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "GTNH 本地增量游戏：数值模拟、工业控制台与实时厂区",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "tsx scripts/balance.ts",
    "dev": "vite",
    "build": "npm run check:content && vue-tsc --noEmit && vite build && tsx scripts/inline-dist.ts",
    "preview": "vite preview",
    "build:3d": "node gtnh3d/build.mjs",
    "check:3d": "node gtnh3d/tools/check-bundle.mjs && node gtnh3d/tools/smoke.mjs",
    "verify:3d": "node gtnh3d/tools/verify-render.mjs && node gtnh3d/tools/verify-atlas.mjs",
    "floor:3d": "node gtnh3d/tools/floor-map.mjs",
    "check:content": "tsx scripts/check-content.ts"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "three": "^0.170.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8",
    "vue-tsc": "^3.3.11"
  }
}
